def create_earnings_windows(
    price_data,
    earnings_data,
    tickers,
    window_days=30,
    pre_event_days=60
):
    earnings_windows = defaultdict(list)

    for num, ticker in enumerate(tickers):
        if num % 50 == 0:
            print(f"processing pt1 ticker {num}/{len(tickers)}")

        price_df = price_data[price_data['ticker'] == ticker].copy()
        earnings_df = earnings_data[earnings_data['ticker'] == ticker].copy()

        price_df['date'] = pd.to_datetime(price_df['date']).dt.tz_localize(None).dt.date
        earnings_df['date'] = pd.to_datetime(earnings_df['date']).dt.date
        earnings_df['Earnings'] = 1

        if len(earnings_df) > 20:
            combined_df = price_df.sort_values('date').reset_index(drop=True)
            combined_df['Earnings'] = 0

            for _, earn_row in earnings_df.iterrows():
                earn_date = earn_row['date']
                combined_df.loc[combined_df['date'] == earn_date, 'Earnings'] = 1

            combined_df['daily return'] = combined_df['close'].pct_change()

            combined_df['2day interval'] = np.where(
                combined_df['Earnings'] == 1,
                (1 + combined_df['daily return'].shift(-1)) * (1 + combined_df['daily return']) - 1,
                0
            )

            earnings_dates = combined_df.loc[combined_df['Earnings'] == 1, 'date'].tolist()

            for earn_date in earnings_dates:
                idx = combined_df.index[combined_df['date'] == earn_date][0]

                start_idx = max(0, idx - pre_event_days)
                end_idx = idx + 2 + window_days
                window_df = combined_df.iloc[start_idx:end_idx].copy()

                earnings_windows[ticker].append(window_df)

    return earnings_windows

def compute_weekly_abnormal(
    window_df,
    spy_df,
    lookback_vol_days=60,
    start_skip=2,
    week_days=5,
    num_weeks=6,
    min_pre_event_obs=15
):
    window_df = window_df.copy()
    window_df['date'] = pd.to_datetime(window_df['date'])
    spy_df = spy_df.copy()
    spy_df['Date'] = pd.to_datetime(spy_df['Date'])

    merged = window_df.merge(
        spy_df[['Date', 'spy_return']],
        left_on='date',
        right_on='Date',
        how='left'
    ).drop(columns=['Date'])

    merged['AR'] = merged['daily return'] - merged['spy_return']

    event_locs = merged.index[merged['Earnings'] == 1].tolist()
    if not event_locs:
        return pd.DataFrame(columns=['week', 'AR_weekly']), np.nan, np.nan, np.nan, pd.DataFrame(), np.nan

    event_loc = event_locs[0]
    earn_date = merged.loc[event_loc, 'date']
    year = earn_date.year
    quarter = earn_date.to_period('Q')

    pre_event_slice = merged.iloc[max(0, event_loc - lookback_vol_days):event_loc].copy()
    pre_event_returns = pre_event_slice['daily return'].dropna()

    if len(pre_event_returns) >= min_pre_event_obs:
        pre_event_vol = pre_event_returns.std(ddof=1)
    else:
        pre_event_vol = np.nan

    event_and_after = merged.iloc[event_loc:].copy()
    first_2day = event_and_after['2day interval'].iloc[0]

    post_event = event_and_after.iloc[start_skip:].copy()

    if post_event.empty:
        weekly_cum_results = pd.DataFrame(columns=['week', 'AR_weekly'])
        return weekly_cum_results, first_2day, quarter, year, merged, pre_event_vol

    n_days = len(post_event)
    week_numbers = np.repeat(np.arange(1, num_weeks + 1), week_days)[:n_days]
    post_event['week'] = week_numbers

    weekly_cum = post_event.groupby('week').agg({
        'daily return': lambda x: (1 + x).prod() - 1,
        'spy_return': lambda x: (1 + x).prod() - 1,
        'AR': lambda x: (1 + x).prod() - 1
    }).reset_index()

    weekly_cum.rename(columns={
        'daily return': 'stock_cum_return',
        'spy_return': 'spy_cum_return',
        'AR': 'abnormal_cum_return'
    }, inplace=True)

    weekly_cum['AR_weekly'] = weekly_cum['stock_cum_return'] - weekly_cum['spy_cum_return']
    weekly_cum_results = weekly_cum[['week', 'AR_weekly']]

    return weekly_cum_results, first_2day, quarter, year, merged, pre_event_vol


def group_results(
    earnings_windows,
    tickers,
    spy_close,
    lookback_vol_days=60
):
    
    all_results = defaultdict(list)

    for num, ticker in enumerate(tickers):
        print(f'processing pt2 ticker {num + 1}/{len(tickers)}')

        for window_df in earnings_windows[ticker]:
            event_locs = window_df.index[window_df['Earnings'] == 1].tolist()
            if not event_locs:
                continue

            earn_date = pd.to_datetime(window_df.loc[event_locs[0], 'date'])

            weekly_cum, first_2day, quarter, year, merged, pre_event_vol = compute_weekly_abnormal(
                window_df=window_df,
                spy_df=spy_close,
                lookback_vol_days=lookback_vol_days
            )

            all_results[ticker].append({
                'earn_date': earn_date,
                'weekly_AR': weekly_cum,
                'first_2day': first_2day,
                'pre_event_vol': pre_event_vol,
                'quarter': quarter,
                'year': year
            })

    return all_results


def flatten_all_results(all_results, max_weeks=6):
    
    records = []

    for ticker, events in all_results.items():
        for e in events:
            weekly_ar = e['weekly_AR']['AR_weekly'].tolist() if not e['weekly_AR'].empty else []
            weekly_ar = (weekly_ar + [np.nan] * max_weeks)[:max_weeks]

            records.append({
                'ticker': ticker,
                'earn_date': e.get('earn_date'),
                'first_2day': e.get('first_2day'),
                'pre_event_vol': e.get('pre_event_vol'),
                'quarter': e.get('quarter'),
                'year': e.get('year'),
                **{f'week{i + 1}': weekly_ar[i] for i in range(max_weeks)}
            })

    df = pd.DataFrame(records)
    week_cols = [f'week{i + 1}' for i in range(max_weeks)]
    df['total_AR'] = df[week_cols].sum(axis=1, skipna=True)

    return df



def extract_signal_features_df(all_results):
    records = []

    for ticker, events in all_results.items():
        for e in events:
            records.append({
                'ticker': ticker,
                'earn_date': e.get('earn_date'),
                'first_2day': e.get('first_2day'),
                'pre_event_vol': e.get('pre_event_vol'),
                'quarter': e.get('quarter'),
                'year': e.get('year')
            })

    df = pd.DataFrame(records)
    df['earn_date'] = pd.to_datetime(df['earn_date'])

