def add_next_trading_day(event_df, price_data, event_date_col='earn_date', trade_delay=2):
    """
    Maps an event date to a future trading date based on actual market calendars.
    trade_delay=2 means if earnings are on Day T, we buy on Day T+2.
    """
    price_dates = price_data[['ticker', 'date']].drop_duplicates().copy()
    price_dates['date'] = pd.to_datetime(price_dates['date'])
    price_dates = price_dates.sort_values(['ticker', 'date']).reset_index(drop=True)

    event_df = event_df.copy()
    event_df[event_date_col] = pd.to_datetime(event_df[event_date_col])
    event_df = event_df.sort_values(['ticker', event_date_col]).reset_index(drop=True)

    output_frames = []

    for ticker, g in event_df.groupby('ticker', sort=False):
        ticker_dates = price_dates.loc[price_dates['ticker'] == ticker, 'date'].sort_values().to_numpy()
        g = g.copy()

        next_dates = []
        for earn_date in g[event_date_col].to_numpy():
            idx = np.searchsorted(ticker_dates, np.datetime64(earn_date), side='left')
            exec_idx = idx + trade_delay
            
            if exec_idx < len(ticker_dates):
                next_dates.append(pd.Timestamp(ticker_dates[exec_idx]))
            else:
                next_dates.append(pd.NaT) 

        g['buy_date'] = next_dates
        output_frames.append(g)

    return pd.concat(output_frames, ignore_index=True)


